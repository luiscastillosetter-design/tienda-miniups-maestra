'use client';

import { useEffect, useState, Suspense } from 'react';
import { useSearchParams, useRouter } from 'next/navigation';
import Image from 'next/image';
import Link from 'next/link';
import { siteConfig } from '@/config/site';
import { productService } from '@/services/productService';
import type { Product } from '@/data/products';
import { Smartphone, Headphones, Home as HomeIcon, Gamepad2, Zap, LayoutGrid, ChevronLeft } from 'lucide-react';

const categories = [
  { id: 0, name: 'Todos', icon: LayoutGrid },
  { id: 1, name: 'Phones', icon: Smartphone },
  { id: 2, name: 'Audio', icon: Headphones },
  { id: 3, name: 'Smart Home', icon: HomeIcon },
  { id: 4, name: 'Gaming', icon: Gamepad2 },
  { id: 5, name: 'Gadgets', icon: Zap },
];

function CatalogoContent() {
  const searchParams = useSearchParams();
  const router = useRouter();
  
  const [products, setProducts] = useState<Product[]>([]);
  const [filteredProducts, setFilteredProducts] = useState<Product[]>([]);
  const [activeCategory, setActiveCategory] = useState<string>('Todos');

  // Cargar todos los productos al iniciar
  useEffect(() => {
    const loadProducts = async () => {
      const data = await productService.getProducts();
      setProducts(data);
      setFilteredProducts(data);
    };
    loadProducts();
  }, []);

  // Escuchar la URL para filtrar si alguien entra directo a una categoría (ej: /catalogo?category=Audio)
  useEffect(() => {
    const categoryParam = searchParams.get('category');
    
    if (products.length > 0) {
      if (!categoryParam || categoryParam.toLowerCase() === 'todos') {
        setActiveCategory('Todos');
        setFilteredProducts(products);
      } else {
        const foundCat = categories.find(c => c.name.toLowerCase() === categoryParam.toLowerCase());
        setActiveCategory(foundCat ? foundCat.name : 'Todos');
        const filtered = products.filter(p => p.category?.toLowerCase() === categoryParam.toLowerCase());
        setFilteredProducts(filtered);
      }
    }
  }, [searchParams, products]);

  const handleCategoryClick = (categoryName: string) => {
    if (categoryName === 'Todos') {
      router.push('/catalogo');
    } else {
      router.push(`/catalogo?category=${categoryName}`);
    }
  };

  return (
    <div className="w-full bg-slate-50 min-h-screen pt-[70px] md:pt-[85px] pb-24 md:pb-12">
      
      {/* Banner Principal del Catálogo */}
      <div className="w-full bg-[#0B132B] px-4 py-8 md:py-12 relative overflow-hidden">
        {/* Decoración de fondo */}
        <div className="absolute inset-0 opacity-10 pointer-events-none">
          <div className="absolute top-0 right-0 w-64 h-64 bg-orange-500 rounded-full blur-3xl -mr-20 -mt-20"></div>
          <div className="absolute bottom-0 left-20 w-40 h-40 bg-white rounded-full blur-2xl -mb-10"></div>
        </div>
        
        <div className="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
          <div className="text-center md:text-left">
            <h1 className="text-3xl md:text-5xl font-black text-white uppercase tracking-tight mb-2">
              {activeCategory === 'Todos' ? 'Catálogo Completo' : activeCategory}
            </h1>
            <p className="text-white/80 font-medium text-sm md:text-base">
              Descubre los mejores equipos y tecnología de alta gama.
            </p>
          </div>
          <Link href="/" className="inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl transition-colors backdrop-blur-sm text-sm">
            <ChevronLeft className="w-4 h-4" />
            Volver
          </Link>
        </div>
      </div>

      {/* Selectores de Categoría - Flexibles Móvil/Desktop */}
      <div className="w-full max-w-7xl mx-auto px-2 md:px-8 mt-8 mb-10">
        <div className="flex overflow-x-auto md:justify-center gap-4 md:gap-10 pb-4 scrollbar-hide px-4">
          {categories.map((category) => {
            const IconComponent = category.icon;
            const isActive = activeCategory === category.name;
            return (
              <button
                key={category.id}
                onClick={() => handleCategoryClick(category.name)}
                className={`flex flex-col items-center gap-3 flex-shrink-0 group cursor-pointer transition-all duration-300 ${
                  isActive ? 'scale-110' : 'hover:scale-105'
                }`}
              >
                <div className={`p-4 rounded-2xl drop-shadow-md transition-all duration-300 ${
                  isActive 
                    ? 'bg-orange-500 text-white shadow-[0_0_20px_rgba(249,115,22,0.6)]' 
                    : 'bg-white text-slate-800 hover:drop-shadow-[0_0_15px_rgba(249,115,22,0.4)] hover:text-orange-500'
                }`}>
                  <IconComponent className="w-6 h-6 md:w-8 md:h-8" strokeWidth={isActive ? 2 : 1.5} />
                </div>
                <span className={`text-xs font-black uppercase tracking-widest transition-colors ${
                  isActive ? 'text-orange-500' : 'text-slate-600 group-hover:text-orange-500'
                }`}>
                  {category.name}
                </span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Grilla de Productos (Diseño Responsivo) */}
      <div className="w-full max-w-7xl mx-auto px-4 md:px-8">
        <div className="flex items-center justify-between mb-6">
          <p className="text-sm font-bold text-slate-500">
            Mostrando {filteredProducts.length} producto{filteredProducts.length !== 1 ? 's' : ''}
          </p>
        </div>

        {filteredProducts.length === 0 ? (
          <div className="flex flex-col items-center justify-center py-32 bg-white rounded-3xl shadow-sm border border-gray-100">
            <Zap className="w-16 h-16 text-gray-200 mb-4" />
            <h3 className="text-xl font-black text-slate-800 mb-2">No hay productos en esta categoría</h3>
            <p className="text-sm text-gray-500 mb-6">Estamos actualizando nuestro inventario. Vuelve pronto.</p>
            <button onClick={() => handleCategoryClick('Todos')} className="px-6 py-3 bg-orange-500 text-white font-bold rounded-xl shadow-md hover:bg-orange-600 transition-colors">
              Ver Catálogo Completo
            </button>
          </div>
        ) : (
          /* Ajuste de columnas: 2 en móvil, 3 en tablet, 4-5 en PC */
          <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 md:gap-6">
            {filteredProducts.map((product) => (
              <Link key={product.id} href={`/product/${product.id}`} className="group h-full">
                <div className="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-orange-500/20 transition-all duration-300 flex flex-col h-full aspect-[9/16] relative border border-gray-100">
                  <div className="relative w-full h-[55%] md:h-[60%] bg-gray-50 overflow-hidden">
                    <Image
                      src={product.images[0]}
                      alt={product.title}
                      fill
                      className="object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    {product.badge && (
                      <div className="absolute top-2 left-2 md:top-3 md:left-3 bg-[#0B132B] text-white text-[10px] md:text-xs font-black px-2 py-1 md:px-3 md:py-1.5 rounded-full shadow-md uppercase tracking-wider">
                        {product.badge}
                      </div>
                    )}
                  </div>
                  
                  <div className="flex flex-col flex-1 p-3 md:p-5 justify-between">
                    <h3 className="text-xs md:text-sm font-bold text-slate-800 line-clamp-2 leading-snug group-hover:text-orange-500 transition-colors">
                      {product.title}
                    </h3>
                    <div className="mt-2">
                      <p className="text-base md:text-xl font-black text-[#0B132B] mb-2 md:mb-3">
                        {siteConfig.currencySymbol}{product.price}
                      </p>
                      <button className="w-full py-2 md:py-3 rounded-xl font-black text-xs md:text-sm bg-slate-100 text-slate-900 group-hover:bg-orange-500 group-hover:text-white transition-all shadow-sm">
                        Ver Producto
                      </button>
                    </div>
                  </div>
                </div>
              </Link>
            ))}
          </div>
        )}
      </div>

    </div>
  );
}

export default function CatalogoPage() {
  return (
    <Suspense fallback={<div className="flex items-center justify-center min-h-screen">Cargando Catálogo...</div>}>
      <CatalogoContent />
    </Suspense>
  );
}
</file>

