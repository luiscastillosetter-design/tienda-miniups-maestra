  const [productForm, setProductForm] = useState({
    title: '',
    price: '',
    category: 'Smart Home',
    description: '',
    features: '',
    images: ['', '', '', '']
  });

  // 2. Carrusel Hero
  const defaultHeroSlides = [
    {
      id: 1,
      title: 'Catálogo Completo',
      btnLink: '/catalogo',
