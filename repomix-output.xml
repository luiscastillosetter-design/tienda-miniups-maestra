  const isVideo = (url?: string) => {
    if (!url) return false;
    return url.endsWith('.mp4') || url.includes('.mp4?') || url.startsWith('data:video');
  };

  const handleCheckout = () => {
    toggleCart();
    router.push('/checkout');
  };

