'use client';

import { useState, useEffect } from 'react';
import useEmblaCarousel from 'embla-carousel-react';
import Autoplay from 'embla-carousel-autoplay';
import Link from 'next/link';
import { ChevronRight } from 'lucide-react';

export function HeroCarousel() {
  // Autoplay de 7 segundos configurado
  const [emblaRef, emblaApi] = useEmblaCarousel({ loop: true, align: 'start' }, [Autoplay({ delay: 7000, stopOnInteraction: false })]);
  const [selectedIndex, setSelectedIndex] = useState(0);
  const [scrollSnaps, setScrollSnaps] = useState<number[]>([]);

  useEffect(() => {
    if (!emblaApi) return;

    const onSelect = () => setSelectedIndex(emblaApi.selectedScrollSnap());
    const onInit = () => {
      setScrollSnaps(emblaApi.scrollSnapList());
      onSelect();
    };

    emblaApi.on('init', onInit);
    emblaApi.on('reInit', onInit);
    emblaApi.on('select', onSelect);

    return () => {
      emblaApi.off('init', onInit);
      emblaApi.off('reInit', onInit);
      emblaApi.off('select', onSelect);
    };
  }, [emblaApi]);

  const scrollTo = (index: number) => emblaApi?.scrollTo(index);

  // Cada tarjeta tiene SU PROPIO BOTÓN y enlace exclusivo
  const slides = [
    {
      id: 1,
      title: 'Gana con nuestro Programa de Embajadores',
      description: 'Sé parte de nuestra comunidad y genera ingresos pasivos mes a mes.',
      bgGradient: 'from-slate-900 to-[#0B132B]',
      btnText: 'Productos',
      btnLink: '/catalogo',
    },
    {
      id: 2,
      title: 'Tecnología de Respaldo Ininterrumpido',
      description: 'Mini UPS inteligentes de alta potencia para tu hogar y oficina.',
      bgGradient: 'from-[#0B132B] to-slate-900',
      btnText: 'Regístrate',
      btnLink: '?auth=register',
    },
    {
      id: 3,
      title: 'Crea tu Cuenta Personalizada',
      description: 'Acceso exclusivo a ofertas secretas y seguimiento en tiempo real de tus pedidos.',
      bgGradient: 'from-slate-900 to-[#0B132B]',
      btnText: 'Afíliate',
      btnLink: '/afiliados',
    },
  ];

  return (
    <div className="w-full">
      <div ref={emblaRef} className="overflow-hidden w-full">
        <div className="flex w-full">
          {slides.map((slide) => (
            <div
              key={slide.id}
              // En móvil tiene padding lateral para crear el efecto "isla", en PC ocupa el 100% de lado a lado
              className="flex-[0_0_100%] min-w-0 relative h-[60vh] md:h-[70vh] w-full px-4 md:px-0 flex items-center justify-center"
            >
              <div
                // Bordes redondeados y sombra suave en móvil; cuadrado y sin márgenes en PC
                className={`w-full h-full bg-gradient-to-br ${slide.bgGradient} flex flex-col justify-center px-6 md:px-20 relative overflow-hidden rounded-3xl md:rounded-none shadow-xl md:shadow-none`}
              >
                {/* Decoración de fondo sutil */}
                <div className="absolute inset-0 opacity-5">
                  <div className="absolute top-10 right-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
                  <div className="absolute bottom-0 left-0 w-64 h-64 bg-orange-500 rounded-full blur-3xl"></div>
                </div>

                <div className="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-start text-left">
                  <h2 className="text-3xl md:text-6xl font-extrabold text-white mb-3 md:mb-4 leading-tight tracking-tight">
                    {slide.title}
                  </h2>
                  <p className="text-sm md:text-xl text-white/80 max-w-xl font-light mb-12">
                    {slide.description}
                  </p>
                </div>

                {/* ÚNICO BOTÓN: Flotante esquina inferior izquierda, tamaño compacto y asegurado con whitespace-nowrap */}
                <div className="absolute bottom-8 md:bottom-10 left-6 md:left-20 z-20">
                  <Link
                    href={slide.btnLink}
                    className="inline-flex items-center gap-2 md:gap-3 px-6 md:px-8 py-3 md:py-3.5 bg-orange-500 text-white font-black rounded-xl hover:shadow-[0_0_20px_rgba(249,115,22,0.6)] transform hover:-translate-y-1 transition-all duration-300 text-xs md:text-lg uppercase tracking-wide whitespace-nowrap"
                  >
                    {slide.btnText}
                    <ChevronRight className="w-4 h-4 md:w-5 md:h-5" />
                  </Link>
                </div>

                {/* PUNTOS DE PAGINACIÓN: Flotando adentro en el centro inferior */}
                <div className="absolute bottom-8 md:bottom-10 left-1/2 -translate-x-1/2 flex justify-center gap-2 md:gap-3 z-20">
                  {scrollSnaps.map((_, index) => (
                    <button
                      key={index}
                      onClick={() => scrollTo(index)}
                      className={`rounded-full transition-all duration-500 shadow-md ${
                        index === selectedIndex
                          ? 'bg-orange-500 w-8 md:w-10 h-2'
                          : 'bg-white/30 hover:bg-white/60 w-2 h-2'
                      }`}
                      aria-label={`Ir a tarjeta ${index + 1}`}
                    />
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
