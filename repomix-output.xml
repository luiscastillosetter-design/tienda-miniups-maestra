  const handleDeleteOffer = (id: any) => {
    const updated = offers.filter((o) => o.id !== id);
    setOffers(updated);
    localStorage.setItem('store_offers', JSON.stringify(updated));
    if (editingOfferId === id) setEditingOfferId(null);
