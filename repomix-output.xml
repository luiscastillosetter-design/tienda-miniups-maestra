'use client';

import { useEffect, useState, Suspense, useRef } from 'react';
import { useSearchParams } from 'next/navigation';
import Image from 'next/image';
import Link from 'next/link';
import { siteConfig } from '@/config/site';
import { productService } from '@/services/productService';
import type { Product } from '@/data/products';
import { Smartphone, Headphones, Home as HomeIcon, Gamepad2, Zap, LayoutGrid, ChevronLeft, ChevronRight } from 'lucide-react';
import { HeroCarousel } from '@/components/HeroCarousel';
import { OffersCarousel } from '@/components/OffersCarousel';

const categories = [
  { id: 0, name: 'Todos', icon: LayoutGrid },
  { id: 1, name: 'Phones', icon: Smartphone },
  { id: 2, name: 'Audio', icon: Headphones },
  { id: 3, name: 'Smart Home', icon: HomeIcon },
  { id: 4, name: 'Gaming', icon: Gamepad2 },
  { id: 5, name: 'Gadgets', icon: Zap },
];

function HomeContent() {
  const searchParams = useSearchParams();
  const [products, setProducts] = useState<Product[]>([]);
  const [selectedCategory, setSelectedCategory] = useState<number | null>(null);
  const [filteredProducts, setFilteredProducts] = useState<Product[]>([]);

  // Referencias para las flechas del carrusel en Desktop
  const trendsRef = useRef<HTMLDivElement>(null);
  const catalogRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const loadProducts = async () => {
      const data = await productService.getProducts();
      setProducts(data);
      setFilteredProducts(data);
    };
    loadProducts();
  }, []);

  useEffect(() => {
    if (selectedCategory === null || selectedCategory === 0) {
      setFilteredProducts(products);
    } else {
      const categoryName = categories.find(c => c.id === selectedCategory)?.name || '';
      const filtered = products.filter(p => p.category?.toLowerCase() === categoryName.toLowerCase());
      setFilteredProducts(filtered);
    }
  }, [selectedCategory, products]);

  useEffect(() => {
    const ref = searchParams.get('ref');
    if (ref) {
      localStorage.setItem('todomax_ref', ref);
    }
  }, [searchParams]);

  const getProductsByCategory = (categoryName: string) => {
    return products.filter(p => p.category?.toLowerCase() === categoryName.toLowerCase()).slice(0, 1);
  };

  const getCatalogProducts = () => {
    return products.slice(0, 5);
  };

  const scrollLeft = (ref: React.RefObject<HTMLDivElement | null>) => {
    if (ref.current) ref.current.scrollBy({ left: -350, behavior: 'smooth' });
  };

  const scrollRight = (ref: React.RefObject<HTMLDivElement | null>) => {
    if (ref.current) ref.current.scrollBy({ left: 350, behavior: 'smooth' });
  };

  return (
    <>
      {/* Mobile View */}
      <div className="md:hidden bg-white min-h-screen relative pb-24 pt-4">
        {/* Hero Carousel */}
        <section className="w-full">
          <HeroCarousel />
        </section>

        {/* Categorías Horizontales (Sin línea gris intrusiva) */}
        <section className="w-full bg-white py-4 px-4">
          <div className="flex overflow-x-auto gap-4 scrollbar-hide">
            {categories.map((category) => {
              const IconComponent = category.icon;
              const isAll = category.id === 0;
              return (
                <Link
                  key={category.id}
                  href={isAll ? '/catalogo' : `/catalogo?category=${category.name}`}
                  onClick={() => setSelectedCategory(isAll ? 0 : category.id)}
                  className="flex flex-col items-center gap-2 flex-shrink-0 group"
                >
                  <div className="p-3 bg-gray-50 rounded-2xl drop-shadow-sm group-hover:drop-shadow-md transition-all duration-300">
                    <IconComponent className="w-7 h-7 text-slate-800 group-hover:text-orange-500 transition-colors" />
                  </div>
                  <span className="text-xs font-semibold text-center text-slate-700">{category.name}</span>
                </Link>
              );
            })}
          </div>
        </section>

        {/* Últimas Tendencias Carrusel */}
        <main className="w-full px-4 py-4" id="productos">
          <h2 className="text-lg font-bold text-slate-900 mb-4">Productos en tendencia</h2>

          {products.length === 0 ? (
            <div className="flex flex-col items-center justify-center py-12 bg-gray-50 rounded-lg">
              <p className="text-sm text-gray-500 font-medium">No hay productos</p>
            </div>
          ) : (
            <div className="flex overflow-x-auto gap-3 snap-x pb-2 scrollbar-hide">
              {categories.slice(1).map((cat) => {
                const catProducts = getProductsByCategory(cat.name);
                return catProducts.map((product) => (
                  <Link key={product.id} href={`/product/${product.id}`} className="group flex-shrink-0">
                    <div className="bg-white border border-gray-200/80 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300 h-full flex flex-col w-[160px] aspect-[9/16]">
                      <div className="relative w-full flex-1 bg-gray-50 overflow-hidden">
                        <Image
                          src={product.images[0]}
                          alt={product.title}
                          fill
                          className="object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                        <div className="absolute top-2 left-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full shadow-xs">
                          {product.badge || 'Nuevo'}
                        </div>
                      </div>

                      <div className="flex flex-col flex-1 p-3">
                        <h3 className="text-xs font-semibold text-slate-900 mb-2 line-clamp-2 flex-1 group-hover:text-orange-600 transition-colors">
                          {product.title}
                        </h3>
                        <p className="text-sm font-extrabold text-orange-500 mb-2">
                          {siteConfig.currencySymbol}{product.price}
                        </p>
                        <button className="w-full py-1.5 rounded-lg font-bold text-xs bg-slate-900 text-white group-hover:bg-orange-500 transition-colors shadow-xs cursor-pointer">
                          Ver
                        </button>
                      </div>
                    </div>
                  </Link>
                ));
              })}
            </div>
          )}
        </main>

        {/* Offers Carousel */}
        <section className="w-full mt-6">
          <OffersCarousel />
        </section>

        {/* Catálogo Carrusel */}
        <section className="w-full px-4 py-6">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-bold text-slate-900">Catálogo</h2>
            <Link href="/catalogo" className="text-xs font-bold text-orange-500">Ver todo</Link>
          </div>
          <div className="flex overflow-x-auto gap-3 snap-x pb-2 scrollbar-hide">
            {getCatalogProducts().map((product) => (
              <Link key={product.id} href={`/product/${product.id}`} className="group flex-shrink-0">
                <div className="bg-white border border-gray-200/80 rounded-2xl overflow-hidden hover:shadow-xl hover:border-gray-300 transition-all duration-300 h-full flex flex-col w-[160px] aspect-[9/16]">
                  <div className="relative w-full flex-1 bg-gray-50 overflow-hidden">
                    <Image
                      src={product.images[0]}
                      alt={product.title}
                      fill
                      className="object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div className="absolute top-2 left-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full shadow-xs">
                      {product.badge || 'Nuevo'}
                    </div>
                  </div>

                  <div className="flex flex-col flex-1 p-3">
                    <h3 className="text-xs font-semibold text-slate-900 mb-2 line-clamp-2 flex-1 group-hover:text-orange-600 transition-colors">
                      {product.title}
                    </h3>
                    <p className="text-sm font-extrabold text-orange-500 mb-2">
                      {siteConfig.currencySymbol}{product.price}
                    </p>
                    <button className="w-full py-1.5 rounded-lg font-bold text-xs bg-slate-900 text-white group-hover:bg-orange-500 transition-colors shadow-xs cursor-pointer">
                      Ver
                    </button>
                  </div>
                </div>
              </Link>
            ))}
          </div>
        </section>
      </div>

      {/* Desktop View */}
      <div className="hidden md:block bg-slate-50 min-h-screen py-8">
        <div className="w-full">
          {/* Hero Carousel */}
          <section className="w-full mb-12">
            <HeroCarousel />
          </section>

          {/* Categorías Grid (Con efectos flotantes de luz e iluminación al pasar el mouse) */}
          <section className="w-full px-8 mb-16">
            <h2 className="text-2xl font-bold text-slate-900 mb-8 text-center">Categorías</h2>
            <div className="flex justify-center gap-16">
              {categories.map((category) => {
                const IconComponent = category.icon;
                const isAll = category.id === 0;
                return (
                  <Link
                    key={category.id}
                    href={isAll ? '/catalogo' : `/catalogo?category=${category.name}`}
                    onClick={() => setSelectedCategory(isAll ? 0 : category.id)}
                    className="flex flex-col items-center gap-4 group cursor-pointer"
                  >
                    <div className="p-4 text-slate-900 group-hover:text-orange-500 drop-shadow-md group-hover:drop-shadow-[0_0_20px_rgba(249,115,22,0.8)] group-hover:-translate-y-2 transition-all duration-300">
                      <IconComponent className="w-12 h-12 transition-colors" strokeWidth={1.5} />
                    </div>
                    <span className="text-sm font-bold text-center text-slate-900 group-hover:text-orange-500 transition-colors uppercase tracking-wider">{category.name}</span>
                  </Link>
                );
              })}
            </div>
          </section>

          {/* Últimas Tendencias (Formato 9:16 gigante con flechas de navegación lateral) */}
          <main className="w-full px-8 mb-16">
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-2xl font-bold text-slate-900">Últimas Tendencias</h2>
              <Link href="/catalogo" className="text-sm font-bold text-orange-500 hover:text-orange-600 flex items-center gap-1">
                Ver todo <ChevronRight className="w-4 h-4" />
              </Link>
            </div>

            {products.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-20 bg-gray-50 rounded-lg">
                <p className="text-base text-gray-500 font-medium">No hay productos</p>
              </div>
            ) : (
              <div className="relative group">
                <button onClick={() => scrollLeft(trendsRef)} className="absolute -left-5 top-1/2 -translate-y-1/2 z-10 bg-white shadow-xl p-4 rounded-full text-slate-900 hover:bg-orange-500 hover:text-white transition-all opacity-0 group-hover:opacity-100">
                  <ChevronLeft className="w-6 h-6" />
                </button>

                <div ref={trendsRef} className="flex overflow-x-auto gap-6 snap-x pb-4 scrollbar-hide px-2">
                  {categories.slice(1).map((cat) => {
                    const catProducts = getProductsByCategory(cat.name);
                    return catProducts.map((product) => (
